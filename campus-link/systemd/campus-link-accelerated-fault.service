[Unit]
Description=campus-link accelerated edge-fault qualification gate
After=campus-link-full-qualification.service campus-link-edge-a.service campus-link-edge-b.service
Wants=campus-link-edge-a.service campus-link-edge-b.service
AssertPathExists=/run/campus-link/qualification-run.manifest
AssertPathExists=/run/campus-link/a11-b22-full.result

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/campus-link-accelerated-fault-soak /srv/openwrt-lab/repo 3600
TimeoutStartSec=3h
TimeoutStopSec=30
KillMode=control-group
OOMPolicy=stop
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/run/campus-link /run/campus-link-install-edge.lock

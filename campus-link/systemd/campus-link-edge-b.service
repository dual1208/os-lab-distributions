[Unit]
Description=campus-link site-b edge
After=campus-link-topology.service
Requires=campus-link-topology.service
PartOf=campus-link-external.target
# Invalid or not-yet-installed rotated credentials must keep retrying without
# a permanent start-limit lockout. RestartSec below prevents a busy loop.
StartLimitIntervalSec=0

[Service]
Type=simple
User=campus-link-b
Group=campus-link-b
NetworkNamespacePath=/run/netns/campus-b
ExecStart=/usr/local/bin/campus-link-edge -config /etc/campus-link/site-b/edge.json
Restart=on-failure
RestartSec=10s
MemoryHigh=80M
MemoryMax=96M
TasksMax=128
LimitNOFILE=512
LimitCORE=0
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=-/etc/campus-link/site-a -/etc/campus-link/pki -/etc/campus-link/relay-fault -/run/campus-link/site-a -/var/lib/campus-link -/srv/openwrt-lab
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/run/campus-link/site-b

#!/usr/bin/env bash
set -euo pipefail

down() {
  ip netns del oslab-a 2>/dev/null || true
  ip netns del oslab-b 2>/dev/null || true
  ip netns del oslab-relay 2>/dev/null || true
  for tap in tap-a-lan tap-b-lan tap-a-transit tap-b-transit; do
    ip link del "$tap" 2>/dev/null || true
  done
  for bridge in br-a-lan br-b-lan br-a-transit br-b-transit; do
    ip link del "$bridge" 2>/dev/null || true
  done
}

up() {
  down
  for bridge in br-a-lan br-b-lan br-a-transit br-b-transit; do
    ip link add "$bridge" type bridge
    ip link set "$bridge" up
  done
  for tap in tap-a-lan tap-b-lan tap-a-transit tap-b-transit; do
    ip tuntap add dev "$tap" mode tap user builder
    ip link set "$tap" up
  done
  ip link set tap-a-lan master br-a-lan
  ip link set tap-b-lan master br-b-lan
  ip link set tap-a-transit master br-a-transit
  ip link set tap-b-transit master br-b-transit

  ip netns add oslab-a
  ip link add ep-a type veth peer name br-ep-a
  ip link set ep-a netns oslab-a
  ip link set br-ep-a master br-a-lan
  ip link set br-ep-a up
  ip -n oslab-a link set lo up
  ip -n oslab-a link set ep-a up
  ip -n oslab-a address add 10.81.0.10/24 dev ep-a
  ip -n oslab-a route add default via 10.81.0.1

  ip netns add oslab-b
  ip link add ep-b type veth peer name br-ep-b
  ip link set ep-b netns oslab-b
  ip link set br-ep-b master br-b-lan
  ip link set br-ep-b up
  ip -n oslab-b link set lo up
  ip -n oslab-b link set ep-b up
  ip -n oslab-b address add 10.82.0.10/24 dev ep-b
  ip -n oslab-b route add default via 10.82.0.1

  ip netns add oslab-relay
  ip link add relay-a type veth peer name br-relay-a
  ip link set relay-a netns oslab-relay
  ip link set br-relay-a master br-a-transit
  ip link set br-relay-a up
  ip link add relay-b type veth peer name br-relay-b
  ip link set relay-b netns oslab-relay
  ip link set br-relay-b master br-b-transit
  ip link set br-relay-b up
  ip -n oslab-relay link set lo up
  ip -n oslab-relay link set relay-a up
  ip -n oslab-relay link set relay-b up
  ip -n oslab-relay address add 172.31.1.2/30 dev relay-a
  ip -n oslab-relay address add 172.31.2.2/30 dev relay-b
  ip netns exec oslab-relay sysctl -q -w net.ipv4.ip_forward=1
  ip -n oslab-relay route add 10.81.0.0/24 via 172.31.1.1
  ip -n oslab-relay route add 10.82.0.0/24 via 172.31.2.1
}

case ${1:-} in
  up) up ;;
  down) down ;;
  *) echo 'usage: openwrt-lab-topology up|down' >&2; exit 2 ;;
esac

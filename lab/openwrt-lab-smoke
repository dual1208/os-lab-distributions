#!/usr/bin/env bash
set -euo pipefail

readonly MODE=${1:-plaintext}
[[ ${MODE} == plaintext || ${MODE} == router-only ]]

if [[ ${MODE} == router-only ]]; then
  for _ in {1..30}; do
    if ip netns exec oslab-a ping -c1 -W1 10.81.0.1 >/dev/null 2>&1 &&
       ip netns exec oslab-b ping -c1 -W1 10.82.0.1 >/dev/null 2>&1; then
      break
    fi
    sleep 2
  done
  ip netns exec oslab-a ping -c2 -W2 10.81.0.1
  ip netns exec oslab-b ping -c2 -W2 10.82.0.1
  ! ip netns exec oslab-a ping -c1 -W1 10.82.0.10 >/dev/null 2>&1
  ! ip netns list | awk '{print $1}' | grep -qx oslab-relay
  ! ip link show br-relay-a >/dev/null 2>&1
  ! ip link show br-relay-b >/dev/null 2>&1
  curl --fail --silent --show-error --insecure --max-time 5 https://127.0.0.1:18443/ >/dev/null
  cat > /run/openwrt-lab/smoke.status <<EOF
STATUS=pass
MODE=router-only
LOCAL=icmp
CROSS_SITE=absent
LUCI=https://127.0.0.1:18443/
EOF
  exit 0
fi

for _ in {1..30}; do
  if ip netns exec oslab-a ping -c1 -W1 10.82.0.10 >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
ip netns exec oslab-a ping -c2 -W2 10.82.0.10
curl --fail --silent --show-error --insecure --max-time 5 https://127.0.0.1:18443/ >/dev/null

# A listener proves the path reaches endpoint B; firewall policy must admit
# 8080 but reject 12345 before either socket is considered reachable.
ip netns exec oslab-b python3 -m http.server 8080 --bind 10.82.0.10 \
  >/run/openwrt-lab/allowed-http.log 2>&1 &
allowed_pid=$!
ip netns exec oslab-b python3 -m http.server 12345 --bind 10.82.0.10 \
  >/run/openwrt-lab/blocked-http.log 2>&1 &
blocked_pid=$!
trap 'kill ${allowed_pid} ${blocked_pid} 2>/dev/null || true' EXIT
sleep 1
ip netns exec oslab-a curl --fail --silent --max-time 5 http://10.82.0.10:8080/ >/dev/null
if ip netns exec oslab-a curl --fail --silent --max-time 3 http://10.82.0.10:12345/ >/dev/null 2>&1; then
  echo 'forbidden TCP/12345 unexpectedly crossed router B' >&2
  exit 3
fi

cat > /run/openwrt-lab/smoke.status <<EOF
STATUS=pass
MODE=plaintext
ALLOWED=icmp,tcp/8080
BLOCKED=tcp/12345
LUCI=https://127.0.0.1:18443/
EOF

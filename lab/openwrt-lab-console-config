#!/usr/bin/env python3
import os
import socket
import time


def read_until(sock, needles, deadline):
    data = b""
    while time.time() < deadline:
        try:
            chunk = sock.recv(8192)
            if not chunk:
                raise ConnectionError("serial console closed")
            data += chunk
        except TimeoutError:
            continue
        if any(needle in data for needle in needles):
            return data
    raise TimeoutError(f"console did not emit one of {needles!r}")


secret_path = "/etc/openwrt-lab/admin.secret"
with open(secret_path, "rb") as handle:
    password = handle.read().strip()

for role in ("a", "b"):
    path = f"/run/openwrt-lab/router-{role}.console"
    deadline = time.time() + 100
    transcript = b""
    while time.time() < deadline:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(path)
            sock.settimeout(1)
            sock.sendall(b"\n")
            while time.time() < deadline:
                try:
                    transcript += sock.recv(8192)
                except TimeoutError:
                    sock.sendall(b"\n")
                if b"root@router-" in transcript or b"root@OpenWrt" in transcript:
                    break
                if b" login:" in transcript:
                    sock.sendall(b"root\n")
                    read_until(sock, (b"Password:",), deadline)
                    sock.sendall(password + b"\n")
                    transcript = read_until(sock, (b"root@router-", b"root@OpenWrt"), deadline)
                    break
            else:
                raise TimeoutError("console shell did not become ready")
            sock.sendall(b"passwd\n")
            read_until(sock, (b"New password",), deadline)
            sock.sendall(password + b"\n")
            read_until(sock, (b"Retype password",), deadline)
            sock.sendall(password + b"\n")
            read_until(sock, (b"password for root changed", b"Password for root changed"), deadline)
            if role == "a":
                local_process, remote_process = "10.81.0.11", "10.82.0.22"
            else:
                local_process, remote_process = "10.82.0.22", "10.81.0.11"
            command = (
                "uci -q delete firewall.process_pair; "
                "uci set firewall.process_pair=rule; "
                "uci set firewall.process_pair.name='Permit authenticated A11-B22 process pair'; "
                "uci set firewall.process_pair.src=transit; "
                "uci set firewall.process_pair.dest=lan; "
                f"uci set firewall.process_pair.src_ip={remote_process}; "
                f"uci set firewall.process_pair.dest_ip={local_process}; "
                "uci set firewall.process_pair.proto=all; "
                "uci set firewall.process_pair.target=ACCEPT; "
                "uci commit firewall; /etc/init.d/firewall reload; "
                "/etc/init.d/uhttpd restart; echo OSLAB_CONFIGURED\n"
            )
            sock.sendall(command.encode())
            read_until(sock, (b"OSLAB_CONFIGURED",), deadline)
            sock.close()
            break
        except (FileNotFoundError, ConnectionRefusedError, TimeoutError):
            time.sleep(2)
    else:
        raise SystemExit(f"router {role} console configuration timed out")

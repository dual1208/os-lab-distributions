# Credentials and private machine inventories
do_model_access_keys
github_token
personal_computer*_info.txt
router_info

# Cloud/runtime state: may contain droplet IDs, addresses, SSH aliases, or lab
# credentials.  Sanitized evidence belongs under docs/verification instead.
.state/
*.secret
cloud-init.rendered.yaml

# Retrieved reference payloads stay local; only their manifest is versioned.
reference/**
!reference/README.md
!reference/MANIFEST.sha256
!reference/SOURCES.tsv

# Generated build and release payloads
out/
*.log
*.exit
